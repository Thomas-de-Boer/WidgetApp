<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.WidgetFragment">

    <TextView
        style="@style/ScreenTitle"
        android:text="@string/menu_widgets" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fragment_widgets_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_medium" />

    <ScrollView
        android:id="@+id/fragment_widgets_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fragment_widget_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fragment_widgets_how_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/fragment_widget_how_to" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/fragment_widget_available"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                style="@style/WidgetListName"
                android:text="@string/quote_widget_name" />

            <TextView
                style="@style/WidgetListDescription"
                android:text="@string/quote_widget_description" />

            <TextView
                style="@style/WidgetListName"
                android:text="@string/image_widget_name" />

            <TextView
                style="@style/WidgetListDescription"
                android:text="@string/image_widget_description" />

            <TextView
                style="@style/WidgetListName"
                android:text="@string/gen_widget_name" />

            <TextView
                style="@style/WidgetListDescription"
                android:text="@string/gen_widget_description" />

            <TextView
                style="@style/WidgetListName"
                android:text="@string/maze_widget_name" />

            <TextView
                style="@style/WidgetListDescription"
                android:text="@string/maze_widget_description" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
