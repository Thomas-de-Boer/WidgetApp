<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/widget_gen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 56 ms per frame is ~18 fps, so the 180 frames make a 10 second loop -->
    <ViewFlipper
        android:id="@+id/widget_gen_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:flipInterval="56"
        android:autoStart="true" />

    <TextView
        android:id="@+id/widget_gen_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/generated_widget_loading"
        android:textColor="@color/white"
        android:background="@color/black"
        android:visibility="gone" />

</RelativeLayout>