<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Plinko"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="plinko_theme"
            app:title="Color theme"
            app:entries="@array/maze_theme_names"
            app:entryValues="@array/maze_theme_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <Preference
            app:key="plinko_reset_best"
            app:title="Reset best"
            app:summary="Set the number next to the star on this widget back to 0"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

</PreferenceScreen>
