<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Look"
        app:iconSpaceReserved="false">

        <ListPreference
            app:key="appearance"
            app:title="Appearance"
            app:entries="@array/appearance_names"
            app:entryValues="@array/appearance_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            />

        <Preference
            app:key="accent_color"
            app:title="Accent color"
            app:summary="Follow your wallpaper or pick your own color"
            app:iconSpaceReserved="false"
            />
    </PreferenceCategory>

    <PreferenceCategory
        app:title="Data"
        app:iconSpaceReserved="false">

        <Preference
            app:key="export_data"
            app:title="Export your data"
            app:summary="Save your settings and uploaded images in a backup file"
            app:iconSpaceReserved="false"
            />

        <Preference
            app:key="import_data"
            app:title="Import your data"
            app:summary="Replace your settings and uploaded images with a backup file"
            app:iconSpaceReserved="false"
            />

        <Preference
            app:key="reset_data"
            app:title="Reset your data"
            app:summary="This will remove all your settings and uploaded images"
            app:iconSpaceReserved="false"
            />
    </PreferenceCategory>

</PreferenceScreen>
