<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@+id/widget_plinko"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/widget_plinko_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- 40 ms per frame is 25 fps, has to match FLIP_INTERVAL_MILLIS in PlinkoRenderer -->
    <ViewFlipper
        android:id="@+id/widget_plinko_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:flipInterval="40"
        android:autoStart="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_plinko_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/plinko_widget_loading"
        android:visibility="gone" />

</FrameLayout>
