<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_settings_quotes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/fragment_settings_quotes_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/arrow_icon" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fragment_settings_quotes_preview_card"
        style="?attr/materialCardViewOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="170dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_small"
        app:cardCornerRadius="20dp">

        <FrameLayout
            android:id="@+id/fragment_settings_quotes_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- stops taps from reaching the buttons of the widget in the preview -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/fragment_settings_quotes_settings_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
